# Seeded once by `make php.install` — an existing value in .env is never
# overwritten. Everything a project is expected to set belongs here, not in
# config/.env, which is enforced on every run.
DOMAIN=localhost

JWT_PASSPHRASE=

TOKEN_SECRET=change_me
XO_PHP_ROOT=${XO_PHP_ROOT}
XO_PHP_IMAGE=${XO_PROJECT_NAME}-php
XO_PHP_PORT=80
SERVER_NAME=localhost
XO_SERVER_NAME=localhost
VITE_API_BASE_URL="https://${SERVER_NAME}"
CORS_ALLOW_ORIGIN=^https*://(localhost|${XO_SERVER_NAME}):[0-9]+

SENSITIVE_DATA_ENCRYPTION_KEY=base64:QUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUE=
SENSITIVE_DATA_ENCRYPTION_KEY_ID=default
